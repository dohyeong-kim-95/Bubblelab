{
  // bubblelab.dev 전체를 서빙하는 단일 워커.
  // 리포 루트의 폴더 하나가 서브도메인 하나에 대응된다.
  "name": "bubblelab",
  "main": "_infra/worker.js",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  // workers.dev 서브도메인 미등록 계정에서도 배포되도록 비활성화
  "workers_dev": false,
  "preview_urls": false,
  // 인증/권한 모델을 갖추기 전까지 개인용 기능은 명시적으로 닫아 둔다.
  // 다시 열 때는 값만 바꾸지 말고 해당 기능의 ACL 검토를 먼저 통과해야 한다.
  "vars": {
    "ENABLE_REALTIME": "false",
    "ENABLE_PLANNER": "false",
    // 익명 채팅(util/chat). 서버는 메시지를 저장하지 않고 브로드캐스트만 한다.
    "ENABLE_CHAT": "true",
    // 데일리 팟캐스트(podcast/). 켜기 전에 GEMINI_API_KEY·PODCAST_SESSION_SECRET
    // secret과 R2 버킷(bubblelab-podcast)이 준비되어야 한다.
    "ENABLE_PODCAST": "true",
    // Web Push 공개키(브라우저로 전달됨). 개인키는 VAPID_PRIVATE_KEY secret에.
    "VAPID_PUBLIC_KEY": "BPtXxH7yViqaAU9lHlCugA07o7hUL22Ft35dMvMnOXRp6q_YN3hrYQ2WAtY5_KRsfmkF-CeZBpfokdb7SmBXKNM",
    // Duri 대화·사진 백업(work/duri). 개인 데이터라 fail-closed로 설계.
    // 켜져 있어도 R2 버킷(bubblelab-duri)·WORK_PASSWORD가 없으면 /_duri 는
    // 런타임에서 닫힌다. 싱크 토큰을 별도 키로 서명하려면 DURI_SINK_SECRET 준비.
    "ENABLE_DURI": "true",
    // 조회 전용 잔고 대시보드(invest/). 실제 계좌 정보를 다루므로 켜져 있어도
    // INVEST_PASSWORD·INVEST_CLIENT_ID·INVEST_CLIENT_SECRET secret이 셋 다 있어야
    // 열린다(하나라도 없으면 런타임에서 503). 내리려면 여기를 "false"로.
    "ENABLE_INVEST": "false",
    // 할 일 앱. 서버 저장이 없어 게이트만 담당한다 — LIFE_PASSWORD 와
    // LIFE_SESSION_SECRET 이 있어야 열린다(없으면 플래그와 무관하게 503).
    "ENABLE_LIFE": "true",
    // 매일 논문 다이제스트(life/papers/). 채점·요약은 엣지가 아니라 집 PC 의
    // Claude Code 가 만들고, 여기서는 받아서 보관하고 디스코드로 보낸다 —
    // 그래서 이 워커에 LLM 키가 필요 없고 cron 도 없다(PC 데몬이 시간을 본다).
    // DISCORD_BOT_TOKEN+DISCORD_CHANNEL_ID 와 PAPERS_SINK_SECRET 이 있어야 돈다.
    // DISCORD_CHAT_CHANNEL_ID 를 더 주면 그 채널에서 자유 대화가 열린다(선택) —
    // 개발자 포털에서 Message Content 인텐트를 켜야 봇이 글을 읽을 수 있다.
    "ENABLE_PAPERS": "true",
    // 항공권 가격 관측(trip/ 계획 탭). 개인 일정은 브라우저에만 있고 여기 오지
    // 않는다 — 서버가 들고 있는 건 노선·날짜별 가격 관측뿐이다. 켜져 있어도
    // 프로바이더 자격증명(AMADEUS_CLIENT_ID/SECRET)이 없으면 조회는 돌지 않고
    // 데몬 push 만 쌓인다. 상류 쿼터를 태우는 기능이라 내리려면 여기를 "false"로.
    "ENABLE_TRIP_WATCH": "false",
    // 실제 예매 가능한 가격을 받으려면 프로덕션 키가 필요하다. 테스트 환경은
    // 제한된 캐시 데이터라 화면에 "참고가"로만 표시된다.
    "AMADEUS_ENV": "test",
    // cron 한 번에 조회할 (출발,귀국) 조합 수. 쿼터에 맞춰 조절한다.
    "TRIP_REFRESH_LIMIT": "12"
  },
  // 팟캐스트 소스 파일·생성 오디오 저장소 (계정에 R2 활성화 필요).
  // 바인딩이 없으면 팟캐스트 라우트는 503으로 닫힌다 (fail-closed).
  "r2_buckets": [
    { "binding": "PODCAST_BUCKET", "bucket_name": "bubblelab-podcast" },
    // Duri 사진 임시 버퍼. 싱크가 받아 ack 하면 폐기된다(영구 저장은 사용자 PC).
    { "binding": "DURI_BUCKET", "bucket_name": "bubblelab-duri" },
    // LIFE 백업 한 덩어리. 표지 같은 큰 것은 담지 않아 작지만, 몇 해 쌓이면
    // DO 값 한도(128KB)를 넘길 수 있어 R2 에 둔다.
    { "binding": "LIFE_BUCKET", "bucket_name": "bubblelab-life" }
  ],
  // 매일 06:40 KST(21:40 UTC) 팟캐스트 자동 생성
  // · 08:00 KST(23:00 UTC) 운세 알림 + 아침 브리핑(날씨) 알림
  // · 6시간마다 항공권 가격 관측 갱신 (trip/ 계획 탭, 오래된 조합부터 조금씩)
  // 6시간마다 돌던 trip 가격 관측 cron 은 잠든 동안 뺐다 — 되살리는 값은 _infra/dormant.js 에 적어 뒀다.
  "triggers": { "crons": ["40 21 * * *", "0 13 * * *", "0 23 * * *"] },
  "routes": [
    { "pattern": "bubblelab.dev/*", "zone_name": "bubblelab.dev" },
    { "pattern": "*.bubblelab.dev/*", "zone_name": "bubblelab.dev" }
  ],
  "secrets": {
    "required": [
      "ADMIN_ID",
      "ADMIN_PASSWORD",
      "ADMIN_SESSION_SECRET",
      "PLANNER_SESSION_SECRET",
      "KASI_SERVICE_KEY"
    ],
    // 선택: 있으면 util/brief 지수를 정식 경로(Twelve Data)로 받고,
    // 없으면 조용히 예비 상류(Yahoo → Stooq)로 내려간다.
    // invest(조회 전용 잔고)를 켤 때 함께 넣는다. 없으면 invest는 닫힌 채로 둔다.
    // 토스 API 키는 여기 넣지 않는다 — 허용 IP 때문에 조회는 집 PC 데몬이 하고
    // 엣지는 결과만 받는다(_src/invest-sink/README.md).
    // 항공권 관측(trip/): AMADEUS_* 는 엣지가 직접 조회할 때, TRIP_SINK_SECRET 은
    // 집 PC 데몬이 실제 예매 화면 가격을 밀어 넣을 때. 둘 다 없으면 관측은 비어
    // 있을 뿐 화면은 뜬다. TRIP_WATCH_SECRET 은 Watch 생성 토큰 서명용(없으면
    // ADMIN_PASSWORD 파생 키로 떨어진다).
    "optional": [
      // 논문 다이제스트의 디스코드 발송과 슬래시 명령.
      //   DISCORD_WEBHOOK_URL 또는 DISCORD_BOT_TOKEN+DISCORD_CHANNEL_ID  → 발송
      //   DISCORD_PUBLIC_KEY + DISCORD_APPLICATION_ID                    → 슬래시 명령
      //   PAPERS_SINK_SECRET  → 집 PC 데몬이 질문을 가져갈 때 쓰는 인증.
      //     답변은 엣지가 아니라 PC 의 Claude Code(구독)가 만든다 — 그래서
      //     여기에 LLM 키가 하나 더 늘지 않는다.
      "DISCORD_WEBHOOK_URL",
      "DISCORD_BOT_TOKEN",
      "DISCORD_CHANNEL_ID",
      "DISCORD_PUBLIC_KEY",
      "DISCORD_APPLICATION_ID",
      "PAPERS_SINK_SECRET",
      "TWELVEDATA_API_KEY",
      "INVEST_PASSWORD",
      "INVEST_SINK_SECRET",
      "AMADEUS_CLIENT_ID",
      "AMADEUS_CLIENT_SECRET",
      "TRIP_WATCH_SECRET",
      "TRIP_SINK_SECRET",
      "LIFE_PASSWORD",
      "LIFE_SESSION_SECRET",
      "LIFE_SINK_SECRET"
    ]
  },
  // /_rt/<이름> 실시간 데이터 서버 (아발론 등 멀티플레이어 토이용)
  "durable_objects": {
    "bindings": [
      { "name": "REALTIME", "class_name": "RealtimeDO" },
      { "name": "ANALYTICS", "class_name": "AnalyticsDO" },
      { "name": "RECORDS", "class_name": "RecordsDO" },
      { "name": "PLANNER", "class_name": "PlannerDO" },
      { "name": "RATE_LIMITER", "class_name": "RateLimiterDO" },
      { "name": "WORK_QNA", "class_name": "WorkQnaDO" },
      { "name": "WORK_REVIEWS", "class_name": "WorkReviewsDO" },
      { "name": "CHAT", "class_name": "ChatDO" },
      { "name": "PODCAST", "class_name": "PodcastDO" },
      { "name": "DURI", "class_name": "DuriDO" },
      { "name": "EMOTICON_REVIEW", "class_name": "EmoticonReviewDO" },
      { "name": "FORTUNE", "class_name": "FortuneDO" },
      { "name": "BRIEF", "class_name": "BriefDO" },
      // 에셋(스티커) 공개 여부 오버라이드 — admin에서 토글, 재배포 없이 반영
      { "name": "ASSET_FLAGS", "class_name": "AssetFlagsDO" },
      // 토스증권 조회 결과 캐시 + 일별 잔고 스냅샷 (수익률 그래프의 점).
      // 토스가 client당 액세스 토큰을 1개만 허용해서 발급을 단일 인스턴스에 모은다.
      { "name": "INVEST", "class_name": "InvestDO" },
      // 매일 arXiv 최적화 논문을 골라 디스코드로 보낸다. 보낸 논문 ID와
      // 지난 다이제스트를 보관한다.
      { "name": "PAPERS", "class_name": "PapersDO" },
      // 항공권 날짜 조합별 최저가 관측 + 관측일별 추이 (trip/ 계획 탭)
      { "name": "TRIP_WATCH", "class_name": "TripWatchDO" },
      // 쓰지 않는다. v17 마이그레이션이 이미 적용돼 있어 클래스를 지우면
      // 배포가 거부되므로 자리만 남겨 둔다 (_infra/life.js 주석 참고).
      { "name": "LIFE", "class_name": "LifeDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RealtimeDO"] },
    { "tag": "v2", "new_sqlite_classes": ["AnalyticsDO"] },
    { "tag": "v3", "new_sqlite_classes": ["RecordsDO"] },
    { "tag": "v4", "new_sqlite_classes": ["PlannerDO"] },
    { "tag": "v5", "new_sqlite_classes": ["RateLimiterDO"] },
    { "tag": "v6", "new_sqlite_classes": ["WorkQnaDO"] },
    { "tag": "v7", "new_sqlite_classes": ["ChatDO"] },
    { "tag": "v8", "new_sqlite_classes": ["PodcastDO"] },
    { "tag": "v9", "new_sqlite_classes": ["WorkReviewsDO"] },
    { "tag": "v10", "new_sqlite_classes": ["DuriDO"] },
    { "tag": "v11", "new_sqlite_classes": ["FortuneDO"] },
    { "tag": "v12", "new_sqlite_classes": ["EmoticonReviewDO"] },
    { "tag": "v13", "new_sqlite_classes": ["BriefDO"] },
    { "tag": "v14", "new_sqlite_classes": ["AssetFlagsDO"] },
    { "tag": "v15", "new_sqlite_classes": ["InvestDO"] },
    { "tag": "v16", "new_sqlite_classes": ["TripWatchDO"] },
    { "tag": "v17", "new_sqlite_classes": ["LifeDO"] },
    { "tag": "v18", "new_sqlite_classes": ["PapersDO"] }
  ]
}
